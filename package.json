{
  "name": "@mcp-z/server",
  "version": "2.0.0",
  "description": "Shared utilities and server orchestration for building MCP (Model Context Protocol) servers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "server-utilities",
    "transport",
    "orchestration",
    "stdio",
    "http",
    "configuration",
    "error-handling",
    "ai",
    "claude",
    "framework"
  ],
  "homepage": "https://github.com/mcp-z/server#readme",
  "bugs": {
    "url": "https://github.com/mcp-z/server/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-z/server.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff.info@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsds validate",
    "format": "tsds format",
    "prepublish:check": "ncp",
    "prepublishOnly": "node scripts/require-dist-tag.cjs && tsds validate",
    "test": "tsds test:node --no-timeouts",
    "test:engines": "nvu engines tsds test:node --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.0.0",
    "express": "^5.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@mcp-z/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "fs-remove-compat": "^1.0.4",
    "get-port": "5.1.1",
    "node-version-use": "^2.4.7",
    "supertest": "^7.1.4",
    "ts-dev-stack": "^1.22.1",
    "tsds-config": "^1.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "tsds": {
    "source": "src/index.ts"
  }
}
